# STL processing
MAX_STL_WORKERS=2

# Single-owner authentication. Set CORS_ORIGIN and PUBLIC_URL to the browser origin.
# ADMIN_SETUP_PASSWORD_FILE points to a privately mounted password file, read only
# when no admin account exists. Alternatively use the private admin:setup command.
# ADMIN_SETUP_PASSWORD_FILE=/run/secrets/ordinus_admin_password
# Secure cookies default to true in production. For explicitly local HTTP only:
# AUTH_COOKIE_SECURE=false

# Themis and Laminus URLs are app settings, not env: set them in the app's
# Settings dialog (or PATCH /api/v1/settings).
